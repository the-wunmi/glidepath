# Glidepath: every variable the app reads. Copy to .env.
# By default the app runs on NEAR testnet (the registry in deployments/testnet.json, the real Chain
# Signatures signer) and Sepolia, which needs RELAYER_* and EVM_FUNDER_PRIVATE_KEY below.
# `pnpm dev:local` runs everything on nodes this machine starts instead (a NEAR sandbox, Hardhat).

# ── Required ───────────────────────────────────────────────────────────────────
# Postgres 17 from docker-compose.yml (project "glidepath", port 5437; POSTGRES_PASSWORD below).
DATABASE_URL=postgres://salesplans:salesplans@localhost:5437/salesplans
# Applied only when the database volume is first created; must match DATABASE_URL.
POSTGRES_PASSWORD=salesplans
# A second copy of this repo on the same machine: give it its own Compose project and database
# volume here, so it never touches the first copy's data (stop the other copy first: the ports are
# shared).
# COMPOSE_PROJECT_NAME=glidepath-2
# DB_VOLUME=glidepath-2_pgdata

# ── Ports (defaults shown) ─────────────────────────────────────────────────────
API_PORT=4400
WEB_ORIGIN=http://localhost:3400
API_ORIGIN=http://127.0.0.1:4400
# Local nodes the API starts: the NEAR sandbox (local network only) and Hardhat (local EVM).
NEAR_SANDBOX_PORT=4420
EVM_NODE_PORT=4430

# ── NEAR: local (sandbox node) or testnet ──────────────────────────────────────
# Testnet uses the registry in deployments/testnet.json and v1.signer-prod.testnet (real MPC).
# Mainnet and real money are out of scope.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Fallback endpoints (comma-separated) used while the first rests after a 429, and the pace per
# endpoint. Public testnet RPCs rate-limit bursts.
NEAR_RPC_FALLBACK_URLS=https://near-testnet.drpc.org
NEAR_RPC_MAX_PER_SECOND=8
# On testnet: the account that relays enclave-signed requests, and in this demo also the founder
# persona and the 1Click simulator's solver (it owns the stand-in vUSDC). Its key stays in .env.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=

# ── EVM: local (Hardhat node), sepolia, or off (no EVM plans; what a server runs) ─
EVM_NETWORK=sepolia
# Keyless public RPCs; the fallbacks serve while the first rate-limits.
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_RPC_FALLBACK_URLS=https://1rpc.io/sepolia,https://sepolia.gateway.tenderly.co,https://0xrpc.io/sep
# Pays for token deployments and each plan address's gas (Sepolia ETH comes from a faucet). The
# launchpad key that deploys tokens is derived from it.
EVM_FUNDER_PRIVATE_KEY=
# The local Hardhat node's chain id (EVM_NETWORK=local).
EVM_CHAIN_ID=31337
# EVM blocks an MPC-signed transfer may sit unmined before the engine re-signs it with higher fees.
EVM_STUCK_BLOCKS=12

# ── Prices ─────────────────────────────────────────────────────────────────────
# Tokens priced live from Binance and Coinbase (keyless), as SYMBOL:PAIR. Other tokens (a demo token
# has no market) use the simulated market the 1Click simulator also quotes from.
LIVE_PRICE_SYMBOLS=NEAR:NEAR,wNEAR:NEAR

# ── 1Click: simulated (default). It has no testnet; live mode is mainnet only ──
ONECLICK_MODE=mock
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Partner JWT from https://partners.near-intents.org. Without it 1Click adds a 0.2% fee and refuses
# confidential quotes.
ONECLICK_JWT=
# Live mode uses 1Click's published quote key (ed25519:reYaWhvwu8Jzo3WUM3zhn6VrhuMEF4eADL17qtRVifc,
# verified 2026-11-11). Set this only if 1Click rotates it; the registry must pin the same key.
ONECLICK_QUOTE_KEY=

# ── Enclave: simulated (in-process), or outlayer: the enclave-wasi module on OutLayer testnet's TDX
# workers, its keys in OutLayer's keystore (deployments/outlayer-testnet.json, made by
# pnpm outlayer:enclave build|upload|prove|register). Runs are NEAR transactions from the relayer
# (~0.002 NEAR each), so the outlayer backend wakes a plan at most every OUTLAYER_TICK_SECONDS.
# Unset, a production server (NODE_ENV=production, NEAR testnet, with that record) uses outlayer and
# everything else the simulator.
# ENCLAVE_BACKEND=simulated
OUTLAYER_TICK_SECONDS=600

# ── Tuning ─────────────────────────────────────────────────────────────────────
# Seconds between enclave wake-ups (the enclave still decides whether a sale is due).
ENCLAVE_TICK_SECONDS=5
# A swap with no final 1Click status this long after signing is shown as in doubt (still polled).
SETTLE_IN_DOUBT_SECONDS=600
# Local, non-chain state: the simulated enclave's hardware secret.
DATA_DIR=.data

# ── Testnet deployment (pnpm deploy:testnet; rehearse first with pnpm deploy:testnet --local) ──
# A NEAR testnet account you control, holding at least ~21 NEAR (5 for the registry account,
# ~12.6 burnt to publish the plan-account code as a global contract, ~1.9 for the stand-in vUSDC,
# the rest for gas and storage). The rehearsal spent 20.53 NEAR.
# Get testnet NEAR from https://near-faucet.io or the NEAR wallet faucet. Mainnet is refused.
DEPLOY_NEAR_RPC_URL=https://near-testnet.drpc.org
DEPLOY_ACCOUNT_ID=
DEPLOY_PRIVATE_KEY=
# The registry is created as <name>.<DEPLOY_ACCOUNT_ID>; the deployer becomes its governance.
DEPLOY_REGISTRY_NAME=vsp-registry
DEPLOY_SIGNER_ACCOUNT_ID=v1.signer-prod.testnet
# Minimum cooling-off (and enclave/quote-key activation delay). 10 minutes on testnet so a change can
# be watched to the end; a real deployment would use 30 days, and the app says so.
DEPLOY_MIN_COOLING_OFF_MS=600000
# Stop before any step that would leave the deployer under this many NEAR (a shared account).
DEPLOY_MIN_BALANCE_NEAR=27
# Empty: deploy the stand-in vusdc.<DEPLOY_ACCOUNT_ID>. Otherwise the asset proceeds are paid in.
DEPLOY_PROCEEDS_ASSET=
DEPLOY_PROCEEDS_DECIMALS=6
DEPLOY_REGISTRY_FUNDING_NEAR=5
# Empty: this machine's simulated enclave (the identity the API presents). Otherwise the enclave's
# ed25519 key, its five measurements as JSON, and sha256 of its attestation quote,
DEPLOY_ENCLAVE_PUBLIC_KEY=
DEPLOY_ENCLAVE_MEASUREMENTS=
DEPLOY_ENCLAVE_QUOTE_HASH=
# and the quote signer: empty means the 1Click simulator's key (.data/oneclick-sim.key), since 1Click
# has no testnet. 1Click's real key is for mainnet.
DEPLOY_QUOTE_SIGNER_KEY=

# ── Labs: Bitcoin vault prototype (pnpm vault:deploy, pnpm vault:demo) ─────────
# The deployer is DEPLOY_ACCOUNT_ID above, with the same DEPLOY_MIN_BALANCE_NEAR floor. The contract
# is created as <name>.<DEPLOY_ACCOUNT_ID> with about 3 NEAR for its code; its key is then deleted.
VAULT_CONTRACT_NAME=btc-vault
# The shortest withdrawal delay any vault on the contract may choose (the contract refuses under a
# minute). Five minutes keeps the demo watchable; a vault guarding real savings would use days.
VAULT_MIN_DELAY_MS=300000
VAULT_FUNDING_NEAR=3
# The vault's owner (empty: the DEPLOY_ account) and a guardian, a second testnet account you control.
VAULT_OWNER_ACCOUNT_ID=
VAULT_OWNER_PRIVATE_KEY=
VAULT_GUARDIAN_ACCOUNT_ID=
VAULT_GUARDIAN_PRIVATE_KEY=
# A testnet4 address you control: the only place a claw-back can send the vault's coins.
VAULT_RECOVERY_ADDRESS=

# ── Server (docker compose --profile app up -d --build --wait) ─────────────────
# The compose file sets the in-container addresses (database, API host and port, DATA_DIR), testnet
# and Sepolia. The secrets are RELAYER_* and EVM_FUNDER_PRIVATE_KEY above.
# Before the first start, copy this machine's .data/enclave-hardware.key and .data/oneclick-sim.key
# into the `apidata` volume: the testnet registry pins the enclave key and quote key derived from them.
# The public URL: writes from any other origin are refused, and writes are rate-limited per client.
# PUBLIC_ORIGIN=https://glidepath.clanker.show
# A long random value, e.g. `openssl rand -hex 24`, on a fresh volume.
# POSTGRES_PASSWORD=
# Bearer token (API only, at least 24 characters, e.g. `openssl rand -hex 24`): manages any plan,
# changes the demo controls, and lets scripts write with no Origin. Unset: no operator.
# OPERATOR_TOKEN=
# Plan creations and token launches allowed per UTC day across all clients (default 10 each).
MAX_PLANS_PER_DAY=10
MAX_LAUNCHES_PER_DAY=10
# Writes the relayer pays for (create, launch, enroll, change, cancel, finalize, reveal, ...) per UTC
# day across all clients, so spam meets a 429 before the reserve floor turns everyone away.
MAX_RELAYER_WRITES_PER_DAY=300
# Sepolia endpoint tried first for visitors' reads (/rpc/evm, next addresses), before EVM_RPC_URL
# and its fallbacks.
# EVM_PROXY_RPC_URL=
# Longest plan accepted, in days from now (default 30 on testnet, no bound locally).
# MAX_PLAN_DAYS=30
# Testnet: spending actions answer "busy" while the relayer holds under this many NEAR (default 2),
# and EVM launches while the Sepolia funder holds under this much ETH (default 0.05).
NEAR_RESERVE=2
EVM_RESERVE=0.05
# on|off. NEAR-token plans (each launch deploys a token). Default: on locally; on testnet only once
# `pnpm deploy:testnet --publish-demo-token --confirm` has published the token code (~17 NEAR burnt).
# NEAR_TOKEN_LAUNCHES=
