{
  "name": "glidepath",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm db:up && pnpm db:migrate",
    "dev": "pnpm db:up && turbo run dev --parallel",
    "dev:local": "NEAR_NETWORK=local EVM_NETWORK=local pnpm dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json",
    "test": "turbo run test",
    "test:chain": "pnpm --filter @glidepath/engine test:chain",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "PUBLIC_ORIGIN=${PUBLIC_ORIGIN:-http://localhost:3400} docker compose up -d --wait postgres",
    "db:down": "PUBLIC_ORIGIN=${PUBLIC_ORIGIN:-http://localhost:3400} docker compose down",
    "db:generate": "pnpm --filter @glidepath/db generate",
    "db:migrate": "pnpm --filter @glidepath/db migrate",
    "contracts:build": "bash contracts/build.sh",
    "contracts:test": "bash contracts/test.sh",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "redteam": "tsx --env-file-if-exists=.env scripts/redteam.ts",
    "replay": "tsx scripts/replay-fetch.ts",
    "verify": "tsx scripts/verify-receipts.ts",
    "verify-receipts": "tsx scripts/verify-receipts.ts",
    "demo:full": "pnpm demo && pnpm redteam && pnpm verify-receipts",
    "deploy:testnet": "tsx --env-file-if-exists=.env scripts/deploy-testnet.ts",
    "vault:deploy": "tsx --env-file-if-exists=.env scripts/vault-deploy.ts",
    "vault:demo": "tsx --env-file-if-exists=.env scripts/vault-demo.ts",
    "trust:deploy": "tsx --env-file-if-exists=.env scripts/trust-deploy.ts",
    "enclave:wasi": "tsx scripts/enclave-wasi.ts",
    "outlayer:enclave": "tsx --env-file-if-exists=.env scripts/outlayer-enclave.ts",
    "outlayer:demo": "tsx scripts/outlayer-demo.ts",
    "oneclick:vectors": "tsx scripts/oneclick-vectors.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@glidepath/core": "workspace:*",
    "@glidepath/db": "workspace:*",
    "@glidepath/enclave": "workspace:*",
    "@glidepath/engine": "workspace:*",
    "@glidepath/near": "workspace:*",
    "@noble/curves": "^2.4.0",
    "@glidepath/verify": "workspace:*",
    "@glidepath/oneclick": "workspace:*",
    "@glidepath/chainsig": "workspace:*",
    "zod": "^4.6.7",
    "viem": "^2.57.17",
    "@glidepath/planner": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@glidepath/btc": "workspace:*",
    "@glidepath/trust": "workspace:*"
  }
}
