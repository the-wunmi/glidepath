{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DBOS_SYSTEM_DATABASE_URL",
    "GLIDEPATH_API",
    "GLIDEPATH_API_ORIGIN",
    "DATA_DIR",
    "TMPDIR",
    "NODE_ENV",
    "API_PORT",
    "API_HOST",
    "API_ORIGIN",
    "WEB_ORIGIN",
    "PUBLIC_ORIGIN",
    "OPERATOR_TOKEN",
    "EVM_PROXY_RPC_URL",
    "NEAR_RESERVE",
    "EVM_RESERVE",
    "NEAR_TOKEN_LAUNCHES",
    "NEAR_NETWORK",
    "NEAR_SANDBOX_PORT",
    "NEAR_RPC_URL",
    "EVM_NETWORK",
    "EVM_NODE_PORT",
    "EVM_RPC_URL",
    "ONECLICK_MODE",
    "ENCLAVE_BACKEND",
    "ENCLAVE_TICK_SECONDS",
    "OUTLAYER_TICK_SECONDS",
    "DEPLOYMENTS_DIR"
  ]
}
